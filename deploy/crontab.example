# Cron del usuario 'deploy' — editar con: crontab -e
# Ajusta la ruta /var/www/inventario-it a la real.

# Programador de Laravel (necesario para el digest de alertas: alerts:digest)
* * * * * cd /var/www/inventario-it && php artisan schedule:run >> /dev/null 2>&1

# Respaldo diario de BD + storage a las 02:30 (conserva 14 días)
30 2 * * * BACKUP_DIR=/var/backups/inventario-it RETENTION_DAYS=14 /var/www/inventario-it/deploy/backup.sh >> /var/log/inventario-backup.log 2>&1
